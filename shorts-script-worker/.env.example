# Next.js(shorts-script) .env의 WORKER_API_SECRET과 반드시 동일해야 함 (서버 전용, 절대 클라이언트에 노출 금지)
WORKER_API_SECRET=random-long-string-here

# 브라우저가 영상 파일을 워커로 "직접" 업로드할 때만 쓰는 별도 토큰.
# shorts-script의 NEXT_PUBLIC_WORKER_UPLOAD_TOKEN과 동일해야 함.
# 클라이언트 JS 번들에 그대로 노출되므로 WORKER_API_SECRET과 절대 같은 값을 쓰지 말 것 —
# 이 토큰은 "job 생성" 권한만 가지며, 팀 비밀번호로 로그인한 사용자만 접근 가능한 화면에서만 쓰인다.
WORKER_UPLOAD_TOKEN=random-long-string-here-upload-only

# Vercel에 배포된 shorts-script 앱 origin (CORS 허용)
# 로컬 개발: http://localhost:3000
ALLOWED_ORIGIN=http://localhost:3000

# small(기본, RAM ~1.5~2GB) / base(RAM ~1GB, 무료 티어에서 OOM 나면 이걸로) / medium(RAM ~5GB, 유료 서버 확보 후)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

DATA_DIR=./data
MAX_UPLOAD_MB=500
JOB_TTL_HOURS=6
LONGFORM_THRESHOLD_SEC=90
