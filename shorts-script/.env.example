# =============================================================
# 팀 공용 비밀번호 (로그인 게이트)
# openssl rand -hex 16 등으로 임의 비밀번호 생성해서 팀에 공유
# =============================================================
TEAM_PASSWORD=change-me

# =============================================================
# Anthropic Claude API
# console.anthropic.com > API Keys
# 모델 ID는 코드(lib/claude.ts)에서 고정 관리 — 여기는 키만
# =============================================================
ANTHROPIC_API_KEY=sk-ant-...

# =============================================================
# Supabase (이 프로젝트 전용 신규 프로젝트 — CareOn/beauty와 분리)
# supabase.com > New project
# =============================================================
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# =============================================================
# 워커 서버 (shorts-script-worker, Railway/Render 배포 URL)
# WORKER_API_SECRET은 워커 서버 .env의 값과 반드시 동일해야 함 (서버 전용)
# =============================================================
WORKER_BASE_URL=https://your-worker.up.railway.app
WORKER_API_SECRET=random-long-string-here

# =============================================================
# 브라우저 → 워커 직접 업로드용 (Vercel 서버리스 요청 크기 제한 회피)
# NEXT_PUBLIC_* 이므로 클라이언트 번들에 노출됨 — 워커의 WORKER_UPLOAD_TOKEN과 동일한 값,
# WORKER_API_SECRET과는 반드시 다른 값을 쓸 것
# =============================================================
NEXT_PUBLIC_WORKER_BASE_URL=https://your-worker.up.railway.app
NEXT_PUBLIC_WORKER_UPLOAD_TOKEN=random-long-string-here-upload-only
