# =============================================================
# Claude API (콘텐츠 생성)
# console.anthropic.com → API Keys
# =============================================================
ANTHROPIC_API_KEY=sk-ant-...

# =============================================================
# Instagram Graph API
# Meta for Developers > 앱 만들기 > Instagram Graph API 추가
# 페이지 액세스 토큰 → 장기 토큰(60일)으로 교환 후 사용
# =============================================================
IG_ACCESS_TOKEN=EAAB...
IG_USER_ID=178414...

# 이미지 호스팅 베이스 URL — Graph API에 public URL 필요
# 로컬: http://localhost:3000
# 프로덕션: https://your-app.vercel.app
PUBLIC_BASE_URL=http://localhost:3000

# =============================================================
# Supabase (PNG 호스팅 + 게시 로그)
# supabase.com → New project → Storage → Create bucket "card-images" (Public)
# =============================================================
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# =============================================================
# Cron 보안 (Vercel Cron 호출 시 인증)
# 임의 32자 random string 권장: openssl rand -hex 32
# =============================================================
CRON_SECRET=random-long-string-here

# =============================================================
# Slack 알림 (옵션) — 게시 성공/실패 알림
# api.slack.com → Incoming Webhooks
# =============================================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# =============================================================
# Puppeteer
# 로컬: NODE_ENV=development → puppeteer (Chromium 자동 다운로드)
# 배포: NODE_ENV=production  → puppeteer-core + @sparticuz/chromium
# =============================================================
