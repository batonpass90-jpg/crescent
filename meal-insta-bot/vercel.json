{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/daily-publish",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/daily-publish",
      "schedule": "0 9 * * *"
    }
  ],
  "functions": {
    "app/api/publish/route.ts": {
      "maxDuration": 300,
      "memory": 2048,
      "includeFiles": "node_modules/@sparticuz/chromium/**"
    },
    "app/api/cron/daily-publish/route.ts": {
      "maxDuration": 300,
      "memory": 2048,
      "includeFiles": "node_modules/@sparticuz/chromium/**"
    }
  }
}
